#!/bin/sh
# pre-push 钩子：推不上去的四种情况，提前拦下来（每条都给可执行的修法）。
#
# 安装：python scripts/install_hooks.py

set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() {
  printf '\n[pre-push] 拒绝推送：%s\n' "$1" >&2
  [ -n "$2" ] && printf '  修法：%s\n' "$2" >&2
  exit 1
}

# 1) 远端必须是 SSH
url="$(git remote get-url origin 2>/dev/null || true)"
case "$url" in
  git@*|ssh://*) : ;;
  "") fail "没有 origin 远端" "git remote add origin git@github.com:Winterwind2017/autocad-agent-kit.git" ;;
  *) fail "远端是 HTTPS（$url）——会卡在凭据弹窗" \
          "git remote set-url origin git@github.com:Winterwind2017/autocad-agent-kit.git" ;;
esac

# 2) SSH 必须通
if command -v ssh >/dev/null 2>&1; then
  if ! ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=8 \
        -T git@github.com 2>&1 | grep -q 'successfully authenticated'; then
    fail "ssh -T git@github.com 不通（没有可用 key）" \
         "ssh-keygen -t ed25519 -C \"you@machine\"，公钥贴到 GitHub → Settings → SSH keys"
  fi
fi

# 3) README 计数 + 4) UNSUPPORTED 状态必须是最新的（否则文档与代码漂移）
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  # Windows 上 `python` 可能是 Microsoft Store 的占位符，优先用 py -3
  if command -v py >/dev/null 2>&1; then PY="py -3"
  elif command -v python >/dev/null 2>&1; then PY=python
  fi
fi

if [ -n "$PY" ]; then
  run_checked() {
    if ! $PY "$@" >/tmp/acadkit_hook_check 2>&1; then
      if grep -q "Python was not found" /tmp/acadkit_hook_check 2>/dev/null; then
        echo "[pre-push] 警告：python 不可用，跳过文档检查" >&2
        return 0
      fi
      cat /tmp/acadkit_hook_check >&2
      fail "文档与代码不一致" "$PY $*"
    fi
  }
  run_checked tools/gen_readme_counts.py --check
  run_checked tools/gen_unsupported.py --check
else
  echo "[pre-push] 警告：找不到 python，跳过文档一致性检查" >&2
fi

echo "[pre-push] OK：远端 SSH、文档计数一致"
exit 0
