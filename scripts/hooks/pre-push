#!/bin/sh
# managed by swkit scripts/install_hooks.py
#
# pre-push hook —— 远端不是 SSH、或 SSH key 不可用时拒绝推送。
# Git 调用：pre-push <remote-name> <remote-url>，stdin 是待推 ref 列表。
#
# 为什么用纯 sh：Windows 的 git 用 sh 执行 hook，而 `#!/usr/bin/env python3`
# 在没装 python3 别名的机器上会直接失败（本项目踩过：hook 把正常推送也挡了）。
# 纯 sh 在 Windows(git-bash)/macOS/Linux 都能跑。

remote_name="${1:-origin}"
remote_url="${2:-}"

case "$remote_url" in
  git@*|ssh://*)
    ;;
  *)
    echo "" >&2
    echo "[swkit pre-push] 拒绝推送：远端 '$remote_name' 不是 SSH。" >&2
    echo "远端 = ${remote_url:-(空)}" >&2
    echo "" >&2
    echo "为什么：HTTPS 远端 + 无凭据助手时，git-credential-manager 会等一个看不见的弹窗，" >&2
    echo "表现为 push 无输出挂死（本项目实测挂过 11 分钟）。" >&2
    echo "" >&2
    echo "修法：git remote set-url $remote_name git@github.com:<owner>/<repo>.git" >&2
    echo "或临时：git -c credential.helper=\"!gh auth git-credential\" push" >&2
    echo "" >&2
    exit 1
    ;;
esac

if ! command -v ssh >/dev/null 2>&1; then
  echo "[swkit pre-push] 拒绝推送：没有 ssh 客户端。" >&2
  exit 1
fi

probe=$(ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=8 \
          -T git@github.com 2>&1)
if ! printf '%s' "$probe" | grep -q "successfully authenticated"; then
  echo "" >&2
  echo "[swkit pre-push] 拒绝推送：SSH 到 GitHub 不通。" >&2
  echo "探测结果：$probe" >&2
  echo "" >&2
  echo "生成并登记 key：" >&2
  echo "    ssh-keygen -t ed25519 -C \"you@machine\"" >&2
  echo "    把 ~/.ssh/id_ed25519.pub 贴到 GitHub → Settings → SSH keys" >&2
  echo "然后验证：" >&2
  echo "    ssh -T git@github.com        # 期望看到 Hi <user>!" >&2
  echo "" >&2
  echo "（确属临时绕过：git push --no-verify）" >&2
  echo "" >&2
  exit 1
fi

exit 0
