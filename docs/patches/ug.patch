+def _cam_blank_top_faces(builder):
+    """Top faces (+Z) of the blank bodies already assigned to this operation.
+
+    NX only produces a floor/volume toolpath when the cut region carries both the
+    part face and the coincident stock face; a cut region built from the part face
+    alone generates nothing and reports "工序无任何刀轨".
+    """
+    if not hasattr(builder, "BlankGeometry"):
+        return []
+    try:
+        blank = builder.BlankGeometry
+        contents = blank.GeometryList.GetContents()
+    except Exception:
+        return []
+    bodies = []
+    for item in contents:
+        if item is None:
+            continue
+        try:
+            members = list(item.GetItems())
+        except Exception:
+            continue
+        for member in members:
+            if member is not None and hasattr(member, "GetFaces"):
+                bodies.append(member)
+    if not bodies:
+        return []
+    uf_modeling = NXOpen.UF.UFSession.GetUFSession().Modeling
+    faces = []
+    for body in bodies:
+        best = None
+        best_z = None
+        for face in body.GetFaces():
+            try:
+                data = uf_modeling.AskFaceData(int(face.Tag))
+                if abs(float(data[2][2]) - 1.0) > 1e-6:
+                    continue
+                z_value = float(data[1][2])
+            except Exception:
+                continue
+            if best_z is None or z_value > best_z:
+                best = face
+                best_z = z_value
+        if best is not None:
+            faces.append(best)
+    return faces
+
+
+def _cam_planar_boundary_curves(builder, faces):
+    """平面铣（PlanarMilling）没有 CutAreaGeometry：边界要按曲线追加，
+    而且必须显式给边界平面与底面，否则 NX 只报“未指定底面”或不生成刀路。"""
+    if not hasattr(builder, "PartBoundary"):
+        return None
+    boundary = builder.PartBoundary
+    existing = [
+        item for item in boundary.BoundaryList.GetContents() if item is not None
+    ]
+    if existing:
+        boundary_set = existing[0]
+    else:
+        boundary_set = boundary.CreateBoundarySetPlanarMill()
+    identity = NXOpen.Matrix3x3()
+    identity.Xx = 1.0
+    identity.Yy = 1.0
+    identity.Zz = 1.0
+    uf_modeling = NXOpen.UF.UFSession.GetUFSession().Modeling
+    added = 0
+    boundary_z = None
+    for face in faces:
+        try:
+            edges = list(face.GetEdges())
+        except Exception:
+            continue
+        if not edges:
+            continue
+        try:
+            data = uf_modeling.AskFaceData(int(face.Tag))
+            start = NXOpen.Point3d(
+                float(data[1][0]), float(data[1][1]), float(data[1][2])
+            )
+            if boundary_z is None:
+                boundary_z = float(data[1][2])
+        except Exception:
+            start = NXOpen.Point3d(0.0, 0.0, 0.0)
+        boundary_set.AppendCurves(edges, start, identity)
+        added += len(edges)
+    if boundary_set.Plane is None and boundary_z is not None:
+        boundary_set.Plane = _work_part().Planes.CreatePlane(
+            NXOpen.Point3d(0.0, 0.0, boundary_z),
+            NXOpen.Vector3d(0.0, 0.0, 1.0),
+            NXOpen.SmartObject.UpdateOption.AfterModeling,
+        )
+    return {"boundary_sets": len(existing) or 1, "curves_added": added}
+
+
+def _cam_set_planar_floor(builder, floor_z):
+    if not hasattr(builder, "Geometry"):
+        return None
+    geometry = builder.Geometry
+    if not hasattr(geometry, "FloorPlane"):
+        return None
+    plane = _work_part().Planes.CreatePlane(
+        NXOpen.Point3d(0.0, 0.0, float(floor_z)),
+        NXOpen.Vector3d(0.0, 0.0, 1.0),
+        NXOpen.SmartObject.UpdateOption.AfterModeling,
+    )
+    geometry.FloorPlane = plane
+    return float(floor_z)
+
